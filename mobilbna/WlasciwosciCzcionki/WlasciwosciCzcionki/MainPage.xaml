<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WlasciwosciCzcionki.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout
        Margin="20"
        HorizontalOptions="Fill"
        Spacing="12">

        <Label
            BackgroundColor="#558B2F"
            FontAttributes="Bold"
            FontSize="26"
            HorizontalOptions="Fill"
            Text="Właściwości czcionki"
            TextColor="White" />

        <Label
            x:Name="RozmiarLabel"
            FontSize="18"
            HorizontalOptions="Fill"
            Text="Rozmiar:"
            TextColor="Black" />

        <Slider
            x:Name="RozmiarSlider"
            HorizontalOptions="Fill"
            Maximum="40"
            Minimum="0"
            ValueChanged="RozmiarSlider_ValueChanged"
            Value="0" />

        <Label
            x:Name="CytatLabel"
            FontSize="14"
            HorizontalOptions="Fill"
            Text="Dzień dobry"
            TextColor="Black" />

        <Button
            BackgroundColor="#558B2F"
            Clicked="ZmienCytat_Clicked"
            CornerRadius="0"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Text="&gt;&gt;"
            TextColor="White"
            WidthRequest="110" />

    </VerticalStackLayout>

</ContentPage>