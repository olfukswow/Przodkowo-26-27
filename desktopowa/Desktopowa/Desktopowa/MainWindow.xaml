<Window
    x:Class="Desktopowa.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Szyfrowanie. Wykonane przez 000000000"
    Width="950"
    Height="600"
    Background="#5F9EA0"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Left"
            Content="Podaj wartość klucza"
            FontSize="18"
            Foreground="#FAEBD7" />

        <Label
            Grid.Row="0"
            Grid.Column="2"
            HorizontalAlignment="Left"
            Content="Tekst zaszyfrowany"
            FontSize="18"
            Foreground="#FAEBD7" />

        <TextBox
            x:Name="KluczTextBox"
            Grid.Row="1"
            Grid.Column="0"
            Width="70"
            Height="30"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            FontSize="16" />

        <Label
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,0,220"
            VerticalAlignment="Top"
            Content="Podaj tekst"
            FontSize="18"
            Foreground="#FAEBD7" />

        <TextBox
            x:Name="TekstJawnyTextBox"
            Grid.Row="2"
            Grid.Column="0"
            Margin="10,45,10,10"
            AcceptsReturn="True"
            FontSize="16"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <Button
            x:Name="SzyfrujButton"
            Grid.Row="2"
            Grid.Column="1"
            Width="90"
            Height="35"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#ADD8E6"
            BorderBrush="#ADD8E6"
            Click="SzyfrujButton_Click"
            Content="Zaszyfruj" />

        <TextBox
            x:Name="TekstZaszyfrowanyTextBox"
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="10,15,10,10"
            Background="#5F9EA0"
            BorderBrush="#FAEBD7"
            BorderThickness="3"
            FontSize="16"
            Foreground="#F0F8FF"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <Button
            x:Name="ZapiszButton"
            Grid.Row="3"
            Grid.Column="2"
            Width="190"
            Height="35"
            HorizontalAlignment="Center"
            Background="#ADD8E6"
            BorderBrush="#ADD8E6"
            Click="ZapiszButton_Click"
            Content="Zapisz szyfr w pliku" />
    </Grid>
</Window>