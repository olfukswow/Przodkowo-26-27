<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NotatkiMobilne.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="listaAndr">

    <Grid BackgroundColor="White" RowDefinitions="Auto,*">

        <Grid
            Grid.Row="0"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto">

            <Entry
                x:Name="nowyElementEntry"
                Grid.Column="0"
                Margin="4,0,0,0"
                BackgroundColor="White"
                FontSize="16"
                Placeholder="Nowy element"
                PlaceholderColor="Gray"
                TextColor="Black" />

            <Button
                Grid.Column="1"
                Margin="0"
                Padding="18,0"
                BackgroundColor="#DC143C"
                Clicked="DodajButton_Clicked"
                CornerRadius="0"
                Text="DODAJ"
                TextColor="White" />
        </Grid>

        <CollectionView
            x:Name="listaNotatek"
            Grid.Row="1"
            BackgroundColor="White"
            ItemsSource="{Binding Notatki}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,6" BackgroundColor="White">
                        <Label
                            FontSize="14"
                            Text="{Binding}"
                            TextColor="#DC143C"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>